---
/**
 * Starlight Hero override.
 * Default Starlight forces hero images to 400x400, which softens UI screenshots.
 * This keeps Starlight's layout and actions, with denser responsive image sizes.
 */
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';

const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	// Preserve 16:10-ish screenshot aspect; generate retina-friendly widths.
	width: 960,
	height: 672,
	widths: [480, 720, 960, 1280, 1600],
	sizes: '(min-width: 50rem) min(42rem, 48vw), min(92vw, 36rem)',
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1.25rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(92%, 36rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.25rem, calc(1.25rem + 1vw), 1.75rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 0.85rem;
			align-items: center;
		}

		.copy > * {
			max-width: 44ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.2rem + 4vw), var(--sl-text-5xl));
			line-height: 1.15;
			font-weight: 700;
			color: var(--sl-color-white);
			letter-spacing: -0.02em;
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.05rem + 1.5vw), 1.125rem);
			line-height: 1.55;
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 0.65rem 0.85rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				/* Image is the visual product; give it a bit more than default 4fr */
				grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
				gap: 2rem 3%;
				padding-block: clamp(2rem, calc(0.75rem + 6vmin), 5.5rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 42rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.copy > * {
				max-width: 40ch;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
